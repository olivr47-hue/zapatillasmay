{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.zapatillasmay.mx" }],
      "destination": "https://zapatillasmay.mx/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/producto/:slug", "destination": "https://zapatillasmay-production.up.railway.app/seo/producto/:slug" },
    { "source": "/sitemap.xml",    "destination": "https://zapatillasmay-production.up.railway.app/sitemap.xml" },
    { "source": "/robots.txt",     "destination": "https://zapatillasmay-production.up.railway.app/robots.txt" },
    { "source": "/pedido-exitoso", "destination": "/index.html" },
    { "source": "/checkout",       "destination": "/index.html" },
    { "source": "/politica-de-devoluciones", "destination": "/politica-de-devoluciones.html" },
    { "source": "/catalogo",       "destination": "/catalogo.html" },
    { "source": "/catalogo/:id",   "destination": "/catalogo.html" },
    { "source": "/(.*)",           "destination": "/index.html" }
  ]
}
