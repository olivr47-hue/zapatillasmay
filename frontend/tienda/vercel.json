{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.zapatillasmay.mx" }],
      "destination": "https://zapatillasmay.mx/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' https: data:; connect-src 'self' https:; frame-src 'self' https:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" }
      ]
    },
    {
      "source": "/(success|pedido-exitoso|pedido-pendiente|pedido-fallido|checkout|carrito)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/producto/:slug", "destination": "https://zapatillasmay-production.up.railway.app/seo/producto/:slug" },
    { "source": "/sitemap.xml",    "destination": "https://zapatillasmay-production.up.railway.app/sitemap.xml" },
    { "source": "/robots.txt",     "destination": "https://zapatillasmay-production.up.railway.app/robots.txt" },
    { "source": "/llms.txt",       "destination": "https://zapatillasmay-production.up.railway.app/llms.txt" },
    { "source": "/feed.json",      "destination": "https://zapatillasmay-production.up.railway.app/feed.json" },
    { "source": "/mcp",            "destination": "https://zapatillasmay-production.up.railway.app/mcp" },
    { "source": "/carrito",        "destination": "/carrito.html" },
    { "source": "/catalogo",       "destination": "/catalogo.html" },
    { "source": "/catalogo/:id",   "destination": "/catalogo.html" },
    { "source": "/politica-de-devoluciones", "destination": "/politica-de-devoluciones.html" },
    { "source": "/tacones",        "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/tacones" },
    { "source": "/sandalias",      "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/sandalias" },
    { "source": "/botas",          "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/botas" },
    { "source": "/botines",        "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/botines" },
    { "source": "/flats",          "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/flats" },
    { "source": "/plataformas",    "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/plataformas" },
    { "source": "/tenis",          "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/tenis" },
    { "source": "/nina",           "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/nina" },
    { "source": "/accesorios",     "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/accesorios" },
    { "source": "/mayoreo",        "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/mayoreo" },
    { "source": "/envios",         "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/envios" },
    { "source": "/nosotros",       "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/nosotros" },
    { "source": "/contacto",       "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/contacto" },
    { "source": "/tabla-tallas",   "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/tabla-tallas" },
    { "source": "/como-comprar",   "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/como-comprar" },
    { "source": "/privacidad",     "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/privacidad" },
    { "source": "/politica-de-devoluciones", "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/politica-de-devoluciones" },
    { "source": "/success",           "destination": "/success.html" },
    { "source": "/pedido-exitoso",   "destination": "/success.html" },
    { "source": "/pedido-pendiente", "destination": "/success.html" },
    { "source": "/pedido-fallido",   "destination": "/success.html" },
    { "source": "/checkout",       "destination": "/checkout.html" },
    { "source": "/links",          "destination": "/links.html" },
    { "source": "/ofertas",        "destination": "https://zapatillasmay-production.up.railway.app/seo/pagina/ofertas" },
    { "source": "/(.*)",           "destination": "/index.html" }
  ]
}
